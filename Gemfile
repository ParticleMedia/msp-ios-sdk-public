source 'https://rubygems.org'

# Fastlane - iOS automation tool
gem 'fastlane', '~> 2.217'

# CocoaPods - iOS dependency management
gem 'cocoapods', '~> 1.14'

# Additional useful gems for iOS development
gem 'xcodeproj', '~> 1.24'        # Xcode project manipulation
gem 'cocoapods-core', '~> 1.14'   # CocoaPods core functionality
gem 'cocoapods-deintegrate', '~> 1.0'  # Pod deintegration
gem 'cocoapods-clean', '~> 0.0'   # Pod cleaning utilities

# Development and testing gems
group :development do
  gem 'rspec', '~> 3.12'          # Testing framework
  gem 'rubocop', '~> 1.50'        # Ruby code style checker
  gem 'rubocop-performance', '~> 1.18'  # Performance linting
end

# Platform-specific gems
platforms :ruby do
  gem 'json', '~> 2.6'            # JSON parsing
  gem 'nokogiri', '~> 1.15'       # XML/HTML parsing
end

# Specify Ruby version
ruby '~> 3.1'

