{
  "_comment": "SSOT: Developer/agent tools registry. Used by sync-agent-rules.py to generate TOOLS_AVAILABLE sections.",
  "makefile_targets": [
    { "name": "make setup", "description": "Install dependencies + configure git hooks" },
    { "name": "make open", "description": "Switch to pods-dev mode and open Xcode" },
    { "name": "make test", "description": "Run Swift unit tests (MSPDemoApp scheme)" },
    { "name": "make validate", "description": "Quick CI validation" },
    { "name": "make rtt", "description": "Round-trip test (target-switching compatibility)" },
    { "name": "make ci", "description": "Full CI pipeline" },
    { "name": "make sync", "description": "Sync agent rules across Claude/Cursor/Codex/Gemini" },
    { "name": "make validate-sync", "description": "Validate multi-agent sync consistency" },
    { "name": "make beta", "description": "Upload DemoApp to TestFlight" },
    { "name": "make release VERSION=x.y.z NOTES=\"...\"", "description": "Production CocoaPods release" },
    { "name": "make clean", "description": "Clean DerivedData and Pods" }
  ],
  "tools": [
    {
      "name": "get-test-template.sh",
      "path": "Scripts/tools/get-test-template.sh",
      "description": "Print Quick/Nimble unit test boilerplate template",
      "usage": "./Scripts/tools/get-test-template.sh"
    },
    {
      "name": "validate-script.sh",
      "path": "Scripts/tools/validate-script.sh",
      "description": "Validate a shell script using shellcheck",
      "usage": "./Scripts/tools/validate-script.sh <script-path>"
    },
    {
      "name": "validate-agent-sync.sh",
      "path": "Scripts/tools/validate-agent-sync.sh",
      "description": "Validate multi-agent consistency across Claude/Cursor/Codex/Gemini",
      "usage": "./Scripts/tools/validate-agent-sync.sh"
    },
    {
      "name": "post-process-protobuf.sh",
      "path": "Scripts/tools/post-process-protobuf.sh",
      "description": "Post-process protoc-generated .pb.swift files for XCFramework compatibility",
      "usage": "./Scripts/tools/post-process-protobuf.sh"
    },
    {
      "name": "format-all-swift.sh",
      "path": "Scripts/tools/format-all-swift.sh",
      "description": "Format all Swift files in the project (excluding Pods/build dirs)",
      "usage": "./Scripts/tools/format-all-swift.sh"
    },
    {
      "name": "generate-context-index.py",
      "path": "Scripts/tools/generate-context-index.py",
      "description": "Generate .context/index.json from context entry frontmatter",
      "usage": "python3 Scripts/tools/generate-context-index.py"
    },
    {
      "name": "sync-agent-rules.py",
      "path": "Scripts/tools/sync-agent-rules.py",
      "description": "Sync all auto-generated sections across Claude/Cursor/Codex/Gemini agent configs",
      "usage": "python3 Scripts/tools/sync-agent-rules.py [--dry-run] [--verbose]"
    }
  ]
}
