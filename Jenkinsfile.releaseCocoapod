// ============================================================================
// MSP iOS SDK - Full Release Pipeline (CocoaPods + SPM via msp-release.sh)
// ============================================================================
// Integrates the unified release flow: preflight, pre_release_setup, create
// release branch, CocoaPods (Trunk), SPM, push, verification.
// Uses: ./Scripts/msp-release.sh --profile=production run <VERSION>
//
// Parameters:
//   BRANCH        - Branch to build from (default: develop)
//   VERSION       - Release version (e.g. 1.2.3)
//   RELEASE_NOTES - Optional release notes
//   RESUME        - Resume a previously failed release
//   SKIP_PREFLIGHT / ONLY_PODS - Advanced options
// ============================================================================

pipeline {
    agent { label 'Mac_Studio' }

    options {
        ansiColor('xterm')
        timestamps()
    }

    parameters {
        gitParameter(
            name: 'BRANCH',
            type: 'PT_BRANCH',
            defaultValue: 'develop',
            branchFilter: 'origin/(develop|feature/.*|release/.*|hotfix/.*)',
            selectedValue: 'DEFAULT',
            sortMode: 'DESCENDING_SMART',
            description: 'Branch to release from. Supported: develop, feature/*, release/*, hotfix/*.'
        )
        string(
            name: 'VERSION',
            defaultValue: '',
            description: 'Release version (e.g. 1.2.3). Required for a new release. Leave blank when RESUME is checked — the version is automatically restored from the saved state.'
        )
        string(
            name: 'RELEASE_NOTES',
            defaultValue: '',
            description: 'Optional release notes. Leave blank for default/auto.'
        )
        booleanParam(
            name: 'RESUME',
            defaultValue: false,
            description: 'Resume a previously failed release. The version is automatically restored from the saved state — leave VERSION blank, any value entered will be ignored.'
        )
        booleanParam(
            name: 'SKIP_PREFLIGHT',
            defaultValue: false,
            description: 'Skip preflight checks (static + build). Use only when preflight was already run.'
        )
        booleanParam(
            name: 'ONLY_PODS',
            defaultValue: false,
            description: 'Run only CocoaPods release (skip SPM).'
        )
        choice(
            name: 'RELEASER_EMAIL',
            choices: [
                'pengyu.gou@newsbreak.com',
                'han.xiang@newsbreak.com',
                'huanzhi.zhang@newsbreak.com',
                'ling.yang@newsbreak.com',
                'mingming.luo@newsbreak.com',
                'shanyu.li@newsbreak.com'
            ],
            description: 'Who is triggering this release? Used for Slack DM notifications.'
        )
    }

    environment {
        // DEVELOPER_DIR is auto-detected in 'Environment check' stage below
        // Ensure Homebrew, rbenv, and gem binaries are in PATH (Jenkins doesn't load shell profile)
        PATH = "/opt/homebrew/bin:/usr/local/bin:/Users/bjdev/.rbenv/shims:/Users/bjdev/.rbenv/bin:${env.PATH}"
        SLACK_CHANNEL = '#msp-ios-sdk'
        SLACK_CONFIG  = 'Scripts/config/slack.conf'
        LANG = 'en_US.UTF-8'
        LC_ALL = 'en_US.UTF-8'
        CI = 'true'
        // Map Jenkins releaser to release script's author email for Slack DM routing
        MSP_AUTHOR_EMAIL = "${params.RELEASER_EMAIL ?: 'pengyu.gou@newsbreak.com'}"
        // Persistent directory on Mac_Studio for release state files.
        // Must use an absolute path writable by the bjdev user — JENKINS_HOME
        // resolves to the Linux master path (/var/lib/jenkins) and is not
        // accessible from the Mac_Studio agent.
        MSP_STATE_PERSIST_DIR = "/Users/bjdev/msp-release-state/${JOB_NAME}"
    }

    stages {
        stage('Environment check') {
            steps {
                script {
                    // Auto-detect Xcode using shared helper script
                    env.DEVELOPER_DIR = sh(script: './Scripts/lib/detect_developer_dir.sh', returnStdout: true).trim()
                    echo "Auto-detected DEVELOPER_DIR: ${env.DEVELOPER_DIR}"
                }
                sh '''
                    echo "=== Environment ==="
                    echo "DEVELOPER_DIR: $DEVELOPER_DIR"
                    echo "PATH: $PATH"
                    echo "Ruby: $(ruby --version 2>/dev/null || echo 'NOT FOUND')"
                    echo "Bundler: $(which bundle 2>/dev/null || echo 'NOT FOUND')"
                    echo "CocoaPods: $(which pod 2>/dev/null || echo 'NOT FOUND')"
                    echo "XcodeGen: $(xcodegen --version 2>/dev/null || echo 'not yet installed')"
                    echo "Xcode: $(xcodebuild -version 2>/dev/null | head -1 || echo 'NOT FOUND')"
                    echo "gh CLI: $(which gh 2>/dev/null || echo 'NOT FOUND')"
                    ls -d /Applications/Xcode*.app 2>/dev/null || echo "No Xcode found"
                    rbenv versions 2>/dev/null || true

                    if ! command -v bundle >/dev/null 2>&1; then
                        echo "ERROR: bundle not found. Install Ruby 3.1+ via rbenv"
                        exit 1
                    fi
                    echo "Installing/upgrading XcodeGen..."
                    brew upgrade xcodegen 2>/dev/null || brew install xcodegen
                    echo "XcodeGen ready: $(xcodegen --version)"
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.BRANCH ?: 'develop'}"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
            }
        }

        // ── Resume path ────────────────────────────────────────────────
        stage('Restore release state') {
            when {
                expression { params.RESUME }
            }
            steps {
                script {
                    sh """
                        set -euo pipefail
                        if [ -f "${env.MSP_STATE_PERSIST_DIR}/.msp-release-state.json" ]; then
                            cp "${env.MSP_STATE_PERSIST_DIR}/.msp-release-state.json" .msp-release-state.json
                            echo "✅ Restored state file from persistent storage"
                            cat .msp-release-state.json
                        elif [ -f .msp-release-state.json ]; then
                            echo "✅ Using existing state file in workspace"
                        else
                            echo "❌ No state file found. Cannot resume."
                            exit 1
                        fi
                    """
                }
            }
        }

        stage('Resume: Install dependencies') {
            when {
                expression { params.RESUME }
            }
            steps {
                sh '''
                    set -euo pipefail
                    tmp_state="$(mktemp -t msp-release-state.XXXXXX)"
                    cp .msp-release-state.json "$tmp_state"
                    git reset --hard HEAD
                    # git clean may exit non-zero if some build artifacts are
                    # locked by other processes; suppress the error since the
                    # state file was already saved to $tmp_state above.
                    git clean -fdx || git clean -fdx || true
                    mv "$tmp_state" .msp-release-state.json
                    bundle install
                    ./Scripts/workspace/update.sh
                    bundle exec pod install
                '''
            }
        }

        stage('Resume release') {
            when {
                expression { params.RESUME }
            }
            steps {
                sshagent(credentials: ['git key']) {
                    withCredentials([
                        string(credentialsId: 'msp-slack-bot-token', variable: 'SLACK_BOT_TOKEN'),
                        string(credentialsId: 'msp-slack-webhook', variable: 'SLACK_WEBHOOK_URL'),
                        string(credentialsId: 'msp-github-token', variable: 'GH_TOKEN')
                    ]) {
                        sh '''
                            set -euo pipefail
                            git checkout -- . 2>/dev/null || true
                            # Do NOT pass a version argument here.
                            # The version is automatically restored from .msp-release-state.json.
                            # Passing a version manually would cause a mismatch between the version
                            # and the saved state, leading to incorrect resume behavior.
                            ./Scripts/msp-release.sh --profile=production --no-ansi resume
                        '''
                    }
                }
            }
        }

        // ── New release path ───────────────────────────────────────────
        stage('Install Ruby dependencies') {
            when {
                expression { !params.RESUME }
            }
            steps {
                sh '''
                    set -euo pipefail
                    bundle install
                '''
            }
        }

        stage('Prepare workspace') {
            when {
                expression { !params.RESUME }
            }
            steps {
                sh '''
                    set -euo pipefail
                    CI="" ./Scripts/workspace/update.sh
                    ./Scripts/ci/install-pods.sh
                '''
            }
        }

        stage('Run full release') {
            when {
                expression { !params.RESUME && params.VERSION?.trim() }
            }
            steps {
                script {
                    def version = params.VERSION.trim()
                    def args = ['--profile=production', '--no-ansi']
                    if (params.SKIP_PREFLIGHT) { args << '--skip-preflight' }
                    if (params.ONLY_PODS) { args << '--only-pods' }
                    args << 'run' << version
                    def argsStr = args.join(' ')
                    def branch = params.BRANCH ?: 'develop'
                    def envVars = ["VERSION=${version}", "BASE_BRANCH=${branch}"]
                    if (params.RELEASE_NOTES?.trim()) {
                        envVars << "RELEASE_NOTES=${params.RELEASE_NOTES.trim()}"
                    }
                    withEnv(envVars) {
                        sshagent(credentials: ['git key']) {
                            withCredentials([
                                string(credentialsId: 'msp-slack-bot-token', variable: 'SLACK_BOT_TOKEN'),
                                string(credentialsId: 'msp-slack-webhook', variable: 'SLACK_WEBHOOK_URL'),
                                string(credentialsId: 'msp-github-token', variable: 'GH_TOKEN')
                            ]) {
                                // Reset workspace, generate release.md, commit so preflight sees clean tree
                                def notes = params.RELEASE_NOTES?.trim() ?: "Release ${version}"
                                writeFile file: 'release.md', text: "# Release ${version}\n\n## Changes\n\n- ${notes}\n\n## End\n"
                                sh '''
                                    set -euo pipefail
                                    git checkout -- . 2>/dev/null || true
                                    git clean -fd Pods/ 2>/dev/null || true
                                    git add release.md
                                    git commit -m "ci: add release notes" --no-verify
                                '''
                                sh """
                                    set -euo pipefail
                                    ./Scripts/msp-release.sh ${argsStr}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('No action') {
            when {
                expression { !params.RESUME && !params.VERSION?.trim() }
            }
            steps {
                echo 'VERSION is empty and RESUME is false. Nothing to do. Set VERSION to start a release, or check RESUME to continue a failed one.'
            }
        }
    }

    post {
        aborted {
            script {
                // Save state file to persistent directory for future resume after manual abort
                sh """
                    mkdir -p "${env.MSP_STATE_PERSIST_DIR}"
                    if [ -f .msp-release-state.json ]; then
                        cp .msp-release-state.json "${env.MSP_STATE_PERSIST_DIR}/.msp-release-state.json"
                        echo "💾 State file saved after manual abort"
                    fi
                """
                archiveArtifacts artifacts: '.msp-release-state.json', allowEmptyArchive: true
            }
            withCredentials([
                string(credentialsId: 'msp-slack-bot-token', variable: 'SLACK_BOT_TOKEN'),
                string(credentialsId: 'msp-slack-webhook', variable: 'SLACK_WEBHOOK_URL')
            ]) {
                sh '''#!/bin/bash
                    set +e
                    VERSION_TO_REPORT="${VERSION:-}"
                    if [ -z "$VERSION_TO_REPORT" ] && [ -f .msp-release-state.json ] && command -v jq >/dev/null 2>&1; then
                        VERSION_TO_REPORT="$(jq -r '.version // empty' .msp-release-state.json 2>/dev/null || true)"
                    fi
                    VERSION_TO_REPORT="${VERSION_TO_REPORT:-unknown}"

                    source ./Scripts/lib/release-common.sh
                    source ./Scripts/notify/slack.sh
                    notify_release_failure "MSP iOS SDK" "$VERSION_TO_REPORT" "Release was manually aborted in Jenkins" "Manual Abort" || true
                '''
            }
        }
        failure {
            script {
                // Save state file to persistent directory for future resume.
                // No node() wrapper — runs in the primary agent workspace to
                // avoid Jenkins allocating a secondary workspace (@2) where
                // the state file does not exist.
                sh """
                    mkdir -p "${env.MSP_STATE_PERSIST_DIR}"
                    if [ -f .msp-release-state.json ]; then
                        cp .msp-release-state.json "${env.MSP_STATE_PERSIST_DIR}/.msp-release-state.json"
                        echo "💾 State file saved for resume"
                    fi
                """
                // Also archive as build artifact for manual recovery
                archiveArtifacts artifacts: '.msp-release-state.json', allowEmptyArchive: true
            }
            withCredentials([
                string(credentialsId: 'msp-slack-bot-token', variable: 'SLACK_BOT_TOKEN'),
                string(credentialsId: 'msp-slack-webhook', variable: 'SLACK_WEBHOOK_URL')
            ]) {
                sh '''#!/bin/bash
                    set +e
                    VERSION_TO_REPORT="${VERSION:-}"
                    if [ -z "$VERSION_TO_REPORT" ] && [ -f .msp-release-state.json ] && command -v jq >/dev/null 2>&1; then
                        VERSION_TO_REPORT="$(jq -r '.version // empty' .msp-release-state.json 2>/dev/null || true)"
                    fi
                    VERSION_TO_REPORT="${VERSION_TO_REPORT:-unknown}"
                    source ./Scripts/lib/release-common.sh
                    source ./Scripts/notify/slack.sh
                    notify_release_failure "MSP iOS SDK" "$VERSION_TO_REPORT" "Release pipeline failed. Use RESUME=true to continue." "Pipeline Failure" || true
                '''
            }
        }
        success {
            withCredentials([
                string(credentialsId: 'msp-slack-bot-token', variable: 'SLACK_BOT_TOKEN'),
                string(credentialsId: 'msp-slack-webhook', variable: 'SLACK_WEBHOOK_URL')
            ]) {
                sh '''#!/bin/bash
                    set +e
                    VERSION_TO_REPORT="${VERSION:-}"
                    if [ -z "$VERSION_TO_REPORT" ] && [ -f .msp-release-state.json ] && command -v jq >/dev/null 2>&1; then
                        VERSION_TO_REPORT="$(jq -r '.version // empty' .msp-release-state.json 2>/dev/null || true)"
                    fi
                    VERSION_TO_REPORT="${VERSION_TO_REPORT:-unknown}"

                    # Extract released pods from state file
                    PODS_TO_REPORT=""
                    if [ -f .msp-release-state.json ] && command -v jq >/dev/null 2>&1; then
                        PODS_TO_REPORT="$(jq -r '.pods // {} | keys | join(", ")' .msp-release-state.json 2>/dev/null || true)"
                    fi

                    # Calculate duration from state file timestamps
                    DURATION_TO_REPORT="unknown"
                    if [ -f .msp-release-state.json ] && command -v jq >/dev/null 2>&1; then
                        STARTED_AT="$(jq -r '.timestamps.started_at // empty' .msp-release-state.json 2>/dev/null || true)"
                        if [ -n "$STARTED_AT" ]; then
                            START_EPOCH=$(date -j -f "%Y-%m-%d %H:%M:%S" "$STARTED_AT" "+%s" 2>/dev/null || date -d "$STARTED_AT" "+%s" 2>/dev/null || echo "")
                            END_EPOCH=$(date "+%s" 2>/dev/null || echo "")
                            if [ -n "$START_EPOCH" ] && [ -n "$END_EPOCH" ]; then
                                DURATION_SECS=$((END_EPOCH - START_EPOCH))
                                DURATION_TO_REPORT="$((DURATION_SECS / 60))m $((DURATION_SECS % 60))s"
                            fi
                        fi
                    fi

                    source ./Scripts/lib/release-common.sh
                    source ./Scripts/notify/slack.sh
                    notify_release_success "MSP iOS SDK" "$VERSION_TO_REPORT" "$PODS_TO_REPORT" "$DURATION_TO_REPORT" "${RELEASE_NOTES:-}" || true
                '''
            }
            script {
                // Clean up persistent state on success (after notification)
                sh """
                    rm -f "${env.MSP_STATE_PERSIST_DIR}/.msp-release-state.json"
                """
            }
        }
    }
}
