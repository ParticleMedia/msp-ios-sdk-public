#!/usr/bin/env bash

# Mock swift binary for testing
# Logs all invocations

MOCK_LOG="${MOCK_LOG:-./mock_invocations.log}"

# Log the invocation
echo "[MOCK] swift $*" >> "$MOCK_LOG" 2>&1

# For now, all swift commands succeed
# Can be extended with failure simulation if needed
if [[ "${MOCK_SWIFT_FAIL:-0}" == "1" ]]; then
    echo "error: swift command failed" >&2
    exit 1
fi

exit 0

