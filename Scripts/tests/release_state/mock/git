#!/usr/bin/env bash

# Mock git binary for testing
# Logs all invocations and can simulate failures based on environment variables
# NOTE: Do NOT use 'local' in this script - it's not inside a function!

MOCK_LOG="${MOCK_LOG:-./mock_invocations.log}"
MOCK_LOG_FILE="${MOCK_LOG_FILE:-${MOCK_LOG}}"

# Log the invocation
echo "[mock_git] $@" >> "$MOCK_LOG_FILE" 2>&1

# Get repo root from ROOT_DIR or current directory
REPO_ROOT="${ROOT_DIR:-$(pwd)}"

# Handle -C flag (skip it and the directory argument)
_mock_args=("$@")
if [[ "${1:-}" == "-C" ]]; then
    shift 2 || true
fi

# Parse command
case "${1:-}" in
    rev-parse)
        case "${2:-}" in
            --show-toplevel)
                echo "$REPO_ROOT"
                ;;
            --abbrev-ref)
                case "${3:-}" in
                    HEAD)
                        if [[ -f "$REPO_ROOT/.git/HEAD" ]]; then
                            _mock_head="$(cat "$REPO_ROOT/.git/HEAD" 2>/dev/null || echo "ref: refs/heads/main")"
                            if [[ "$_mock_head" == ref:* ]]; then
                                echo "${_mock_head#ref: refs/heads/}"
                            else
                                echo "main"
                            fi
                        else
                            echo "main"
                        fi
                        ;;
                    *)
                        echo "main"
                        ;;
                esac
                ;;
            --verify|--quiet)
                # Check if tag exists: git rev-parse --verify --quiet refs/tags/<tag>
                _mock_ref="${4:-${3:-}}"
                if [[ "$_mock_ref" == refs/tags/* ]]; then
                    _mock_tag_name="${_mock_ref#refs/tags/}"
                    if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" == *"$_mock_tag_name"* ]]; then
                        echo "$_mock_ref"
                        exit 0
                    fi
                    exit 1
                else
                    echo "$_mock_ref"
                fi
                ;;
            --git-dir)
                echo ".git"
                ;;
            --is-inside-work-tree)
                echo "true"
                ;;
            *)
                echo "$REPO_ROOT"
                ;;
        esac
        ;;
    status)
        case "${2:-}" in
            --porcelain)
                if [[ "${MOCK_GIT_DIRTY:-0}" == "1" ]]; then
                    echo " M modified_file.txt"
                fi
                ;;
            *)
                echo "On branch main"
                echo "nothing to commit, working tree clean"
                ;;
        esac
        ;;
    branch)
        case "${2:-}" in
            --show-current)
                if [[ -f "$REPO_ROOT/.git/HEAD" ]]; then
                    _mock_head="$(cat "$REPO_ROOT/.git/HEAD" 2>/dev/null || echo "ref: refs/heads/main")"
                    if [[ "$_mock_head" == ref:* ]]; then
                        echo "${_mock_head#ref: refs/heads/}"
                    else
                        echo "main"
                    fi
                else
                    echo "main"
                fi
                ;;
            -D|-d)
                # Delete branch (succeeds by default)
                _mock_branch="${3:-}"
                ;;
            *)
                echo "* main"
                ;;
        esac
        ;;
    checkout)
        case "${2:-}" in
            -b)
                _mock_branch="${3:-}"
                if [[ -d "$REPO_ROOT/.git" ]]; then
                    echo "ref: refs/heads/$_mock_branch" > "$REPO_ROOT/.git/HEAD" 2>/dev/null || true
                fi
                ;;
            *)
                _mock_branch="${2:-}"
                if [[ -d "$REPO_ROOT/.git" ]]; then
                    echo "ref: refs/heads/$_mock_branch" > "$REPO_ROOT/.git/HEAD" 2>/dev/null || true
                fi
                ;;
        esac
        ;;
    tag)
        case "${2:-}" in
            -d|--delete)
                _mock_tag="${3:-}"
                if [[ -n "$_mock_tag" ]]; then
                    if [[ "${MOCK_GIT_FAIL_ON_TAG_DELETE:-0}" == "1" ]]; then
                        echo "error: tag '${_mock_tag}' not found" >&2
                        exit 1
                    fi
                    echo "Deleted tag '${_mock_tag}'"
                fi
                ;;
            -l|--list)
                if [[ -n "${MOCK_GIT_TAGS:-}" ]]; then
                    echo "$MOCK_GIT_TAGS"
                fi
                ;;
            -a)
                _mock_tag="${3:-}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_CREATE:-0}" == "1" ]]; then
                    echo "error: failed to create tag '${_mock_tag}'" >&2
                    exit 1
                fi
                if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" != *"$_mock_tag"* ]]; then
                    export MOCK_GIT_TAGS="${MOCK_GIT_TAGS} $_mock_tag"
                elif [[ -z "${MOCK_GIT_TAGS:-}" ]]; then
                    export MOCK_GIT_TAGS="$_mock_tag"
                fi
                ;;
            *)
                _mock_tag="${2:-}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_CREATE:-0}" == "1" ]]; then
                    echo "error: failed to create tag '${_mock_tag}'" >&2
                    exit 1
                fi
                if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" != *"$_mock_tag"* ]]; then
                    export MOCK_GIT_TAGS="${MOCK_GIT_TAGS} $_mock_tag"
                elif [[ -z "${MOCK_GIT_TAGS:-}" ]]; then
                    export MOCK_GIT_TAGS="$_mock_tag"
                fi
                ;;
        esac
        ;;
    push)
        _mock_remote="${2:-origin}"
        case "${3:-}" in
            :refs/tags/*)
                _mock_tag="${3#:refs/tags/}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to delete remote tag '${_mock_tag}'" >&2
                    exit 1
                fi
                ;;
            --delete)
                _mock_branch="${4:-}"
                if [[ "${MOCK_GIT_FAIL_ON_BRANCH_DELETE:-0}" == "1" ]]; then
                    echo "error: failed to delete remote branch '${_mock_branch}'" >&2
                    exit 1
                fi
                ;;
            --force)
                if [[ "${MOCK_GIT_FAIL_ON_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to push" >&2
                    exit 1
                fi
                ;;
            *)
                if [[ "${MOCK_GIT_FAIL_ON_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to push" >&2
                    exit 1
                fi
                ;;
        esac
        ;;
    config)
        # Handle git config commands
        case "${2:-}" in
            user.email)
                echo "test@example.com"
                ;;
            user.name)
                echo "Test User"
                ;;
            *)
                echo ""
                ;;
        esac
        ;;
    ls-remote)
        # Return empty (no remote tags/branches)
        ;;
    diff|show-ref|ls-files|log|fetch|remote)
        # Read-only operations, always succeed
        ;;
    *)
        # Unknown command, log and succeed
        ;;
esac

exit 0
