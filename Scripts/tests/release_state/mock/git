#!/usr/bin/env bash

# Mock git binary for testing
# Logs all invocations and can simulate failures based on environment variables

MOCK_LOG="${MOCK_LOG:-./mock_invocations.log}"
MOCK_LOG_FILE="${MOCK_LOG_FILE:-${MOCK_LOG}}"

# Log the invocation
echo "[mock_git] $@" >> "$MOCK_LOG_FILE" 2>&1

# Get repo root from ROOT_DIR or current directory
REPO_ROOT="${ROOT_DIR:-$(pwd)}"

# Parse command
case "${1:-}" in
    rev-parse)
        case "${2:-}" in
            --show-toplevel)
                # Return the repo root
                echo "$REPO_ROOT"
                ;;
            --abbrev-ref)
                case "${3:-}" in
                    HEAD)
                        # Return current branch name
                        if [[ -f "$REPO_ROOT/.git/HEAD" ]]; then
                            local head_content
                            head_content="$(cat "$REPO_ROOT/.git/HEAD" 2>/dev/null || echo "ref: refs/heads/main")"
                            if [[ "$head_content" == ref:* ]]; then
                                echo "${head_content#ref: refs/heads/}"
                            else
                                echo "main"
                            fi
                        else
                            echo "main"
                        fi
                        ;;
                    *)
                        echo "main"
                        ;;
                esac
                ;;
            --verify|--verify|--quiet)
                # Check if tag exists: git rev-parse --verify --quiet refs/tags/<tag>
                local ref="${4:-}"
                if [[ "$ref" == refs/tags/* ]]; then
                    local tag_name="${ref#refs/tags/}"
                    if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" == *"$tag_name"* ]]; then
                        echo "$ref"
                    fi
                    # Exit 0 if tag exists, 1 if not (quiet mode)
                    # For now, assume tag doesn't exist unless MOCK_GIT_TAGS is set
                    if [[ -z "${MOCK_GIT_TAGS:-}" ]]; then
                        exit 1
                    fi
                else
                    echo "$ref"
                fi
                ;;
            *)
                # Other rev-parse operations
                echo "$REPO_ROOT"
                ;;
        esac
        ;;
    status)
        case "${2:-}" in
            --porcelain)
                # Return empty (clean working tree)
                # Or return staged changes if MOCK_GIT_DIRTY=1
                if [[ "${MOCK_GIT_DIRTY:-0}" == "1" ]]; then
                    echo " M modified_file.txt"
                fi
                # Otherwise return nothing (clean)
                ;;
            *)
                # Regular status
                echo "On branch main"
                echo "nothing to commit, working tree clean"
                ;;
        esac
        ;;
    branch)
        case "${2:-}" in
            --show-current)
                # Return current branch
                if [[ -f "$REPO_ROOT/.git/HEAD" ]]; then
                    head_content="$(cat "$REPO_ROOT/.git/HEAD" 2>/dev/null || echo "ref: refs/heads/main")"
                    if [[ "$head_content" == ref:* ]]; then
                        echo "${head_content#ref: refs/heads/}"
                    else
                        echo "main"
                    fi
                else
                    echo "main"
                fi
                ;;
            -D|-d)
                # Delete branch (succeeds by default)
                local branch_name="${3:-}"
                ;;
            *)
                # List branches or other operations
                echo "* main"
                ;;
        esac
        ;;
    checkout)
        case "${2:-}" in
            -b)
                # Create and checkout new branch: git checkout -b <branch> [from]
                branch_name="${3:-}"
                # Update .git/HEAD if possible
                if [[ -d "$REPO_ROOT/.git" ]]; then
                    echo "ref: refs/heads/$branch_name" > "$REPO_ROOT/.git/HEAD" 2>/dev/null || true
                fi
                ;;
            *)
                # Checkout existing branch
                branch_name="${2:-}"
                if [[ -d "$REPO_ROOT/.git" ]]; then
                    echo "ref: refs/heads/$branch_name" > "$REPO_ROOT/.git/HEAD" 2>/dev/null || true
                fi
                ;;
        esac
        ;;
    tag)
        case "${2:-}" in
            -d|--delete)
                # Delete local tag: git tag -d <tag>
                local tag_name="${3:-}"
                if [[ -n "$tag_name" ]]; then
                    if [[ "${MOCK_GIT_FAIL_ON_TAG_DELETE:-0}" == "1" ]]; then
                        echo "error: tag '${tag_name}' not found" >&2
                        exit 1
                    fi
                fi
                ;;
            -l|--list)
                # List tags: git tag -l [pattern]
                if [[ -n "${MOCK_GIT_TAGS:-}" ]]; then
                    echo "$MOCK_GIT_TAGS"
                fi
                # Otherwise return empty
                ;;
            -a)
                # Create annotated tag: git tag -a <tag> -m <message>
                local tag_name="${3:-}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_CREATE:-0}" == "1" ]]; then
                    echo "error: failed to create tag '${tag_name}'" >&2
                    exit 1
                fi
                # Add to MOCK_GIT_TAGS if not already there
                if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" != *"$tag_name"* ]]; then
                    export MOCK_GIT_TAGS="${MOCK_GIT_TAGS} $tag_name"
                elif [[ -z "${MOCK_GIT_TAGS:-}" ]]; then
                    export MOCK_GIT_TAGS="$tag_name"
                fi
                ;;
            *)
                # Create lightweight tag or other tag operations
                local tag_name="${2:-}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_CREATE:-0}" == "1" ]]; then
                    echo "error: failed to create tag '${tag_name}'" >&2
                    exit 1
                fi
                # Add to MOCK_GIT_TAGS if not already there
                if [[ -n "${MOCK_GIT_TAGS:-}" ]] && [[ "$MOCK_GIT_TAGS" != *"$tag_name"* ]]; then
                    export MOCK_GIT_TAGS="${MOCK_GIT_TAGS} $tag_name"
                elif [[ -z "${MOCK_GIT_TAGS:-}" ]]; then
                    export MOCK_GIT_TAGS="$tag_name"
                fi
                ;;
        esac
        ;;
    push)
        local remote="${2:-origin}"
        case "${3:-}" in
            :refs/tags/*)
                # Delete remote tag: git push origin :refs/tags/<tag>
                local tag_name="${3#:refs/tags/}"
                if [[ "${MOCK_GIT_FAIL_ON_TAG_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to delete remote tag '${tag_name}'" >&2
                    exit 1
                fi
                ;;
            --delete)
                # Delete remote branch: git push origin --delete <branch>
                local branch_name="${4:-}"
                if [[ "${MOCK_GIT_FAIL_ON_BRANCH_DELETE:-0}" == "1" ]]; then
                    echo "error: failed to delete remote branch '${branch_name}'" >&2
                    exit 1
                fi
                ;;
            --force)
                # Force push: git push origin --force <branch>
                if [[ "${MOCK_GIT_FAIL_ON_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to push" >&2
                    exit 1
                fi
                ;;
            *)
                # Push branch or tag
                if [[ "${MOCK_GIT_FAIL_ON_PUSH:-0}" == "1" ]]; then
                    echo "error: failed to push" >&2
                    exit 1
                fi
                ;;
        esac
        ;;
    diff|show-ref|ls-files)
        # Read-only operations, always succeed
        ;;
    *)
        # Unknown command, log and succeed
        ;;
esac

exit 0

