#!/usr/bin/env bash

# Mock xcodebuild binary for testing
# Logs all invocations

MOCK_LOG="${MOCK_LOG:-./mock_invocations.log}"

# Log the invocation
echo "[MOCK] xcodebuild $*" >> "$MOCK_LOG" 2>&1

# For now, all xcodebuild commands succeed
# Can be extended with failure simulation if needed
if [[ "${MOCK_XCODEBUILD_FAIL:-0}" == "1" ]]; then
    echo "error: xcodebuild command failed" >&2
    exit 1
fi

exit 0

