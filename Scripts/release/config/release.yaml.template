# ============================================================================
# MSP iOS SDK Release Configuration Template
# ============================================================================
# Purpose: Template for configuring MSP iOS SDK releases.
#
# Usage:
#   1. Copy this template to create your release configuration:
#        cp Scripts/release/config/release.yaml.template Scripts/release/config/release.yaml
#
#   2. Edit release.yaml and fill in the version field:
#        version: "1.0.0"
#
#   3. Run the release:
#        ./Scripts/msp-release.sh run --config Scripts/release/config/release.yaml
#
#   4. Or use CLI to override config values:
#        ./Scripts/msp-release.sh run 1.0.0 --config Scripts/release/config/release.yaml
#
# Override Priority (highest to lowest):
#   1. CLI flags (e.g., --skip-pods, VERSION argument)
#   2. This config file (release.yaml)
#   3. Built-in defaults (in config.sh)
#
# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# - This is a TEMPLATE file. Do NOT commit release.yaml to git.
# - The actual release.yaml should be created per-release and may contain
#   release-specific overrides.
# - Module order matters! Dependencies must be listed before dependents.
# - For pods-release mode, all core XCFrameworks must be built first.
# - For spm-release mode, Package.swift must be generated and validated.
#
# ============================================================================

# ═══════════════════════════════════════════════════════════════════════════
# RELEASE METADATA
# ═══════════════════════════════════════════════════════════════════════════

# Release version (REQUIRED for actual releases)
# Format: Semantic versioning (e.g., "1.0.0", "0.0.3", "1.2.3-beta.1")
# Example: "1.0.0"
version: ""

# Release branch name (OPTIONAL)
# If empty, will be auto-generated as: "release/<version>"
# Example: "release/1.0.0"
# If specified, must follow the pattern: "release/<version>"
release_branch: ""

# Base branch to create release from (OPTIONAL)
# Default: "main"
# This is the branch that the release branch will be created from.
# Example: "main", "develop", "master"
base_branch: "main"

# ═══════════════════════════════════════════════════════════════════════════
# COCOAPODS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# CocoaPods release mode: pods-release
# - Requires all core XCFrameworks to be built (MSPCore, MSPiOSCore, etc.)
# - Adapters are released as source-based pods
# - Core modules are released as binary XCFrameworks

pods:
  # Enable/disable CocoaPods release
  # Set to false to skip CocoaPods release entirely
  enabled: true
  
  # Pods to release (in dependency order - CRITICAL!)
  # 
  # IMPORTANT: Order matters! Dependencies must be listed before dependents.
  # For example, MSPCore must come before MSPGoogleAdapter (which depends on MSPCore).
  #
  # Core Modules (5 total - binary XCFrameworks):
  #   - MSPSharedLibraries    (foundation, no dependencies)
  #   - MSPOMSDK              (depends on MSPSharedLibraries)
  #   - MSPCore               (depends on MSPSharedLibraries, SwiftProtobuf)
  #   - MSPiOSCore            (depends on MSPCore, MSPSharedLibraries)
  #   - NovaCore              (depends on MSPiOSCore, MSPOMSDK, MSPKingfisher, lottie-ios, SnapKit, Shimmer)
  #
  # Common Modules:
  #   - MSPGoogleAdsTypes    (abstraction layer for Google Mobile Ads SDK)
  #
  # Adapter Modules (10 total - source-based):
  #   - MSPPrebidAdapter      (depends on MSPCore, MSPSharedLibraries)
  #   - MSPGoogleAdapter      (depends on MSPCore, MSPiOSCore, MSPGoogleAdsTypes)
  #   - MSPFacebookAdapter    (depends on MSPCore, MSPiOSCore)
  #   - NovaAdapter           (depends on NovaCore, MSPiOSCore)
  #   - AmazonAdapter          (depends on MSPCore, MSPiOSCore)
  #   - UnityAdapter           (depends on MSPCore, MSPiOSCore)
  #   - InmobiAdapter          (depends on MSPCore, MSPiOSCore)
  #   - MobilefuseAdapter      (depends on MSPCore, MSPiOSCore)
  #   - MintegralAdapter        (depends on MSPCore, MSPiOSCore)
  #   - PubmaticAdapter         (depends on MSPCore, MSPiOSCore)
  #
  # Recommended order (ensures dependencies are satisfied):
  modules:
    # Core modules (foundation first)
    - MSPSharedLibraries
    - MSPOMSDK
    - MSPCore
    - MSPiOSCore
    - NovaCore
    
    # Common modules
    - MSPGoogleAdsTypes
    
    # Adapter modules (alphabetical, but dependencies already satisfied above)
    - AmazonAdapter
    - InmobiAdapter
    - MintegralAdapter
    - MobilefuseAdapter
    - MSPFacebookAdapter
    - MSPGoogleAdapter
    - MSPPrebidAdapter
    - NovaAdapter
    - PubmaticAdapter
    - UnityAdapter

# ═══════════════════════════════════════════════════════════════════════════
# SWIFT PACKAGE MANAGER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# SPM release mode: spm-release
# - Requires all core XCFrameworks to be built
# - Adapters are included as source-based targets
# - Core modules are included as binaryTarget XCFrameworks

spm:
  # Enable/disable SPM release
  # Set to false to skip SPM release entirely
  enabled: true
  
  # SPM packages to release
  #
  # Note: In SPM mode, the Package.swift.template defines all products and targets.
  # This list is used for validation and selective release operations.
  #
  # Core Packages (5 total - binaryTarget):
  #   - MSPSharedLibraries
  #   - MSPOMSDK
  #   - MSPCore
  #   - MSPiOSCore
  #   - NovaCore
  #
  # Adapter Packages (10 total - source targets):
  #   - MSPPrebidAdapter
  #   - MSPGoogleAdapter
  #   - MSPFacebookAdapter
  #   - NovaAdapter
  #   - AmazonAdapter
  #   - UnityAdapter
  #   - InmobiAdapter
  #   - MobilefuseAdapter
  #   - MintegralAdapter
  #   - PubmaticAdapter
  #
  # Common Packages:
  #   - MSPGoogleAdsTypes (source target)
  #
  # Note: The top-level "MSPAds" product includes all core modules.
  # Individual adapters can be imported separately.
  packages:
    # Core packages
    - MSPSharedLibraries
    - MSPOMSDK
    - MSPCore
    - MSPiOSCore
    - NovaCore
    
    # Common packages
    - MSPGoogleAdsTypes
    
    # Adapter packages
    - AmazonAdapter
    - InmobiAdapter
    - MintegralAdapter
    - MobilefuseAdapter
    - MSPFacebookAdapter
    - MSPGoogleAdapter
    - MSPPrebidAdapter
    - NovaAdapter
    - PubmaticAdapter
    - UnityAdapter

# ═══════════════════════════════════════════════════════════════════════════
# NOTIFICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Configure Slack notifications for release events

notifications:
  # Slack channel for release notifications
  # Examples: "#msp-release", "#ios-sdk-releases", "#engineering"
  # Leave empty to disable Slack notifications
  slack_channel: "#msp-release"
  
  # Send DM to release executor on failure
  # Set to true to receive a direct message when release fails
  # Requires Slack user ID or email to be configured in release scripts
  dm_on_failure: true
  
  # (Optional) Slack user ID or email for DM notifications
  # Example: "U1234567890" (Slack user ID) or "user@example.com" (email)
  # If not set, DM will use the executor's Git user email
  # dm_user: ""

# ═══════════════════════════════════════════════════════════════════════════
# ADVANCED OPTIONS (Optional - for future use)
# ═══════════════════════════════════════════════════════════════════════════
# These options are reserved for future implementation.
# Do not uncomment unless the feature is implemented in msp-release.sh

# options:
#   # Run in dry-run mode (validate without making changes)
#   dry_run: false
#   
#   # Enable verbose logging
#   verbose: false
#   
#   # Skip pre-release validation
#   skip_validation: false
#   
#   # Build adapters in parallel (if supported)
#   parallel_adapters: true
#   
#   # Custom XCFramework output directory
#   xcframework_output: "Binary"
#   
#   # Custom SPM package output directory
#   spm_output: "."

# ============================================================================
# MODULE REFERENCE
# ============================================================================
# Quick reference for all modules in the MSP iOS SDK:
#
# CORE MODULES (5):
#   1. MSPSharedLibraries    - Third-party SDK aggregator (PrebidMobile, etc.)
#   2. MSPOMSDK               - Open Measurement SDK wrapper
#   3. MSPCore                - Core ad serving logic, auction, bidding
#   4. MSPiOSCore             - iOS-specific adapter interfaces and utilities
#   5. NovaCore               - Nova ad format rendering engine
#
# COMMON MODULES (1):
#   1. MSPGoogleAdsTypes      - Google Mobile Ads SDK abstraction layer
#
# ADAPTER MODULES (10):
#   1. MSPPrebidAdapter       - Prebid.org header bidding adapter
#   2. MSPGoogleAdapter        - Google AdMob/Ad Manager adapter
#   3. MSPFacebookAdapter     - Meta Audience Network adapter
#   4. NovaAdapter            - Nova ad format adapter
#   5. AmazonAdapter           - Amazon Publisher Services adapter
#   6. UnityAdapter            - Unity Ads adapter
#   7. InmobiAdapter           - InMobi adapter
#   8. MobilefuseAdapter       - MobileFuse adapter
#   9. MintegralAdapter        - Mintegral adapter
#  10. PubmaticAdapter         - PubMatic adapter
#
# TOTAL: 16 modules (5 core + 1 common + 10 adapters)
# ============================================================================

