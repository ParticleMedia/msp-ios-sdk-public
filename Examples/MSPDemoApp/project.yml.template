name: MSPDemoApp
options:
  minimumXcodeGenVersion: 2.38.0
  deploymentTarget:
    iOS: "15.0"
configs:
  Debug: debug
  Release: release
settings:
  base:
    CURRENT_PROJECT_VERSION: 1
    DEVELOPMENT_TEAM: 4PEHUZX8QH
    INFOPLIST_FILE: MSPDemoApp/Info.plist
    IPHONEOS_DEPLOYMENT_TARGET: "15.0"
    MARKETING_VERSION: 3.1.10-prerelease
    PRODUCT_BUNDLE_IDENTIFIER: MSPDemoApp.MSPDemoApp
    SWIFT_VERSION: 5.0
    TARGETED_DEVICE_FAMILY: "1,2"
{{ PACKAGES_BLOCK }}
targetTemplates:
  BaseAppTarget:
    type: application
    platform: iOS
    sources:
      - path: MSPDemoApp
    settings:
      base:
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME: AccentColor
        SWIFT_VERSION: 5.0
{{ PODS_SETTINGS }}
        LD_RUNPATH_SEARCH_PATHS:
          - "$(inherited)"
          - "@executable_path/Frameworks"
  TestTarget:
    type: bundle.unit-test
    platform: iOS
    sources:
      - path: ../../Tests/Shared
        excludes:
          - "**/.DS_Store"
    settings:
      base:
        ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES: "YES"
        SWIFT_VERSION: "5.0"
        TEST_HOST: "$(BUILT_PRODUCTS_DIR)/MSPDemoApp.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/MSPDemoApp"
{{ PODS_SETTINGS }}
