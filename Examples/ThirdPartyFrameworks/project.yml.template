# XcodeGen Project for Third-Party Frameworks
# Builds SwiftProtobuf and MSPSnapKit for XCFramework packaging.
# MSPSnapKit is built as static framework to allow static linkage into NovaCore.
# Note: Shimmer is now provided via XCFramework (Shimmer Plan B), not built here.

name: ThirdPartyFrameworks

options:
  minimumXcodeGenVersion: 2.38.0
  deploymentTarget:
    iOS: "15.0"
  bundleIdPrefix: msp.thirdparty
  developmentLanguage: en

configs:
  Debug: debug
  Release: release

settings:
  base:
    IPHONEOS_DEPLOYMENT_TARGET: "15.0"
    TARGETED_DEVICE_FAMILY: "1,2"
    SWIFT_VERSION: "5.0"
    DEFINES_MODULE: YES
    BUILD_LIBRARY_FOR_DISTRIBUTION: YES
    MACH_O_TYPE: mh_dylib
    DYLIB_INSTALL_NAME_BASE: "@rpath"
    INSTALL_PATH: "$(LOCAL_LIBRARY_DIR)/Frameworks"
    SKIP_INSTALL: NO
    CODE_SIGN_IDENTITY: ""
    CODE_SIGNING_REQUIRED: NO
    CODE_SIGNING_ALLOWED: NO
    CLANG_ENABLE_MODULES: YES

targets:
  SwiftProtobuf:
    type: framework
    platform: iOS
    sources:
      - path: ../../Pods/SwiftProtobuf/Sources/SwiftProtobuf
        excludes:
          - "**/*.md"
    settings:
      base:
        PRODUCT_NAME: SwiftProtobuf
        PRODUCT_BUNDLE_IDENTIFIER: msp.thirdparty.SwiftProtobuf
        PRODUCT_MODULE_NAME: SwiftProtobuf
        SWIFT_OBJC_INTERFACE_HEADER_NAME: ""

  MSPSnapKit:
    type: framework
    platform: iOS
    sources:
      - path: ../../ThirdParty/MSPSnapKit/Sources
        excludes:
          - "**/*.md"
    settings:
      base:
        PRODUCT_NAME: MSPSnapKit
        PRODUCT_BUNDLE_IDENTIFIER: msp.thirdparty.MSPSnapKit
        PRODUCT_MODULE_NAME: MSPSnapKit
        SWIFT_OBJC_INTERFACE_HEADER_NAME: ""
        MACH_O_TYPE: staticlib

  # Lottie removed — NovaCore no longer depends on lottie-ios

  # Shimmer is now provided via XCFramework (Shimmer Plan B)
  # Removed: Shimmer target (no longer built from Pods source)

  # Kingfisher is NOT built here - project uses MSPKingfisher pod (source-based) instead
  # MSPKingfisher/Sources is gitignored and only exists after pod install's prepare_command runs
  # Pre-built Kingfisher.xcframework exists in ThirdParty/Kingfisher/ if needed
  # Removed: Kingfisher target (causes XcodeGen validation error during pre_install hook)

schemes:
  SwiftProtobuf:
    build:
      targets:
        SwiftProtobuf: all
    archive:
      config: Release

  MSPSnapKit:
    build:
      targets:
        MSPSnapKit: all
    archive:
      config: Release

  # Lottie scheme removed — NovaCore no longer depends on lottie-ios
  # Shimmer scheme removed (Shimmer Plan B: using XCFramework)
  # Kingfisher scheme removed (using MSPKingfisher pod instead)
