{
  "module": "DebugRadioCell",
  "prefix": "DRC",
  "description": "Test cases for DebugRadioCellViewModel",
  "cases": [
    {
      "id": "DRC001",
      "type": "unit",
      "class": "DebugRadioCellViewModel",
      "method": "init(debugOption:)",
      "description": "Exposes the option id and title",
      "given": { "option": "MockDebugOption with id and title" },
      "when": "init(debugOption: option)",
      "then": { "id": "matches option.id", "title": "matches option.displayTitle" },
      "priority": "high",
      "tags": ["unit", "initialization"]
    },
    {
      "id": "DRC002",
      "type": "unit",
      "class": "DebugRadioCellViewModel",
      "method": "setSelected(_:)",
      "description": "Updates selection state and publishes changes",
      "given": { "isSelected": false },
      "when": "setSelected(true)",
      "then": { "isSelected": true, "isSelectedPublisher": "emits true" },
      "priority": "high",
      "tags": ["unit", "selection", "combine"]
    }
  ]
}
