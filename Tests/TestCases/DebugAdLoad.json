{
  "module": "DebugAdLoad",
  "prefix": "DAL",
  "description": "Test cases for Debug Ad Load feature (DebugAdLoadSectionViewModel, DebugAdLoadViewModel)",
  "cases": [
    {
      "id": "DAL001",
      "type": "unit",
      "class": "DebugAdLoadSectionViewModel",
      "method": "init(from:)",
      "description": "Creates view models from section data",
      "given": { "sectionData": "MockDebugSection with options" },
      "when": "init(from: sectionData)",
      "then": { "id": "matches section id", "title": "matches section title", "numberOfCells": "equals options count" },
      "priority": "high",
      "tags": ["unit", "initialization"]
    },
    {
      "id": "DAL002",
      "type": "unit",
      "class": "DebugAdLoadSectionViewModel",
      "method": "cellViewModel(at:)",
      "description": "Exposes accessors and respects bounds",
      "given": { "sectionData": "MockDebugSection with options" },
      "when": "cellViewModel(at: -1) or cellViewModel(at: count)",
      "then": { "result": "nil for out-of-bounds indices" },
      "priority": "medium",
      "tags": ["unit", "boundary"]
    },
    {
      "id": "DAL003",
      "type": "unit",
      "class": "DebugAdLoadSectionViewModel",
      "method": "selectCell(at:)",
      "description": "Updates selection state and returns the selected cell",
      "given": { "sectionData": "MockDebugSection with multiple options" },
      "when": "selectCell(at: 1)",
      "then": { "selectedIndex": 1, "selectedCell.id": "matches option[1].id", "isSelected": "correct for each cell" },
      "priority": "high",
      "tags": ["unit", "selection"]
    },
    {
      "id": "DAL004",
      "type": "unit",
      "class": "DebugAdLoadSectionViewModel",
      "method": "visible",
      "description": "Toggles visibility",
      "given": { "initialVisible": true },
      "when": "visible = false",
      "then": { "visible": false },
      "priority": "low",
      "tags": ["unit", "visibility"]
    },
    {
      "id": "DAL005",
      "type": "unit",
      "class": "DebugAdLoadSectionViewModel",
      "method": "init(from:)",
      "description": "Handles empty options",
      "given": { "sectionData": "MockDebugSection with empty options" },
      "when": "init(from: emptySection)",
      "then": { "numberOfCells": 0, "selectedIndex": "nil", "selectedCell": "nil" },
      "priority": "medium",
      "tags": ["unit", "edge-case"]
    },
    {
      "id": "DAL006",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "init",
      "description": "Creates sections from repository data",
      "given": { "placements": "non-empty", "sections": "non-empty" },
      "when": "init with repositories",
      "then": { "fetchCallCount": 1, "sections.count": "equals repository sections count" },
      "priority": "high",
      "tags": ["unit", "initialization"]
    },
    {
      "id": "DAL007",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "init",
      "description": "Sets default selection for sections without showCondition",
      "given": { "sections": "minimal sections without showCondition" },
      "when": "init with repositories",
      "then": { "selectedIndex": 0 },
      "priority": "medium",
      "tags": ["unit", "initialization", "default"]
    },
    {
      "id": "DAL008",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "init",
      "description": "Handles empty placements and sections",
      "given": { "placements": "empty", "sections": "empty" },
      "when": "init with repositories",
      "then": { "sections": "empty" },
      "priority": "medium",
      "tags": ["unit", "edge-case"]
    },
    {
      "id": "DAL009",
      "type": "behavior",
      "feature": "Debug Ad Load Visibility",
      "scenario": "Shows Nova sections when Nova + Interstitial are selected",
      "given": ["Production-like sections", "Nova ad network selected", "Interstitial format selected"],
      "when": "Visibility rules are applied",
      "then": ["Creative type section is visible", "Layout section is visible"],
      "priority": "high",
      "tags": ["behavior", "visibility"]
    },
    {
      "id": "DAL010",
      "type": "behavior",
      "feature": "Debug Ad Load Visibility",
      "scenario": "Hides Nova sections when conditions are not met",
      "given": ["Production-like sections", "Non-Nova ad network selected", "Banner format selected"],
      "when": "Visibility rules are applied",
      "then": ["Creative type section is hidden", "Layout section is hidden"],
      "priority": "high",
      "tags": ["behavior", "visibility"]
    },
    {
      "id": "DAL011",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "getTestParameters()",
      "description": "Includes basic parameters for selected options",
      "given": { "adNetwork": "google" },
      "when": "getTestParameters()",
      "then": { "test_ad": true, "ad_network": "msp_google" },
      "priority": "high",
      "tags": ["unit", "parameters"]
    },
    {
      "id": "DAL012",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "getTestParameters()",
      "description": "Includes Nova-specific parameters when selected",
      "given": { "adNetwork": "nova", "adFormat": "interstitial", "creativeType": "nativeImage" },
      "when": "getTestParameters()",
      "then": { "creative_type": "image" },
      "priority": "high",
      "tags": ["unit", "parameters", "nova"]
    },
    {
      "id": "DAL013",
      "type": "behavior",
      "feature": "Debug Ad Load Callbacks",
      "scenario": "Emits ad presentation signal on successful load",
      "given": ["Valid placement selected", "Mock ad configured to succeed"],
      "when": "loadAd() is called",
      "then": ["adPresentationPublisher emits signal"],
      "priority": "high",
      "tags": ["behavior", "callback", "success"]
    },
    {
      "id": "DAL014",
      "type": "behavior",
      "feature": "Debug Ad Load Callbacks",
      "scenario": "Emits toast signal on load error",
      "given": ["Valid placement selected", "Mock ad configured to fail"],
      "when": "loadAd() is called",
      "then": ["toastSignalPublisher emits error message"],
      "priority": "high",
      "tags": ["behavior", "callback", "error"]
    },
    {
      "id": "DAL015",
      "type": "unit",
      "class": "DebugAdLoadViewModel",
      "method": "onAdDismissed(ad:)",
      "description": "Does not clear the ad reference on dismissal",
      "given": { "ad": "loaded interstitial ad" },
      "when": "onAdDismissed(ad:)",
      "then": { "ad": "not nil" },
      "priority": "medium",
      "tags": ["unit", "lifecycle"]
    }
  ]
}
