.DS_Store

# Xcode generated files (NEVER commit these)
*.pbxproj
*.xcscheme
*.xcworkspace
*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/xcshareddata/
*.xcscmblueprint
*.xccheckout
xcuserdata/
xcshareddata/
*.xcuserdatad/
*.xcuserdata/
*.xcuserstate
DerivedData/
*.mode1v3
*.mode2v3
project.xcworkspace/
build/

# Internal Xcode project workspaces (never track these)
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/project.xcworkspace/**

# Swift Package Manager artifacts
.swiftpm/
SourcePackages/
Packages/
Package.resolved
.build/
/.build/
*.build/
msp-ios-sdk.xcworkspace/xcshareddata/swiftpm/local-packages.json
msp-ios-sdk.xcworkspace/contents.xcworkspacedata

# ============================================================================
# SWITCHING-GENERATED FILES (Template Architecture)
# ============================================================================
# These files are generated during Pods ↔ SPM switching and must NEVER be committed.
# Developer-maintained templates (*.template) are tracked in Git.
# Runtime files are generated from templates by switch-target.sh.

# Package.swift - Generated from Package.swift.template in SPM mode, deleted in Pods mode
Package.swift

# Package.swift.disabled - Legacy rename approach (no longer used)
Package.swift.disabled

# workspace.yml - Generated by generate_workspace.sh
workspace.yml

# Generated workspace - Created by XcodeGen from workspace.yml
.generated/

# Xcode SPM caches inside project/workspace bundles
*.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
**/xcuserdata/*/swiftpm/

# CocoaPods
Pods/
Podfile.lock

# Generated XCFrameworks / build outputs
output/
outputMSPiOSCore/
outputNova/
NovaAdapter/NovaCore.xcframework/
MSPSharedLibraries/MSPiOSCore.xcframework
MSPFacebookAdapter/build/
MSPGoogleAdapter/build/
MSPFacebookAdapter/*.xcframework/
MSPGoogleAdapter/*.xcframework/

# Swift Package Manager artifacts (duplicate entries removed - see above)

# Ignore all generated third-party XCFrameworks
Build/ReleaseArtifacts/XCFrameworks/*Kingfisher*
Build/ReleaseArtifacts/XCFrameworks/*SnapKit*
Build/ReleaseArtifacts/XCFrameworks/*Lottie*
Build/ReleaseArtifacts/XCFrameworks/*Shimmer*
Build/ReleaseArtifacts/XCFrameworks/*SwiftProtobuf*
Build/ReleaseArtifacts/XCFrameworks/*Amazon*
Build/ReleaseArtifacts/XCFrameworks/*DTBiOSSDK*
Build/ReleaseArtifacts/XCFrameworks/*InMobi*
Build/ReleaseArtifacts/XCFrameworks/*IronSource*
Build/ReleaseArtifacts/XCFrameworks/*MobileFuse*
Build/ReleaseArtifacts/XCFrameworks/*MTG*
Build/ReleaseArtifacts/XCFrameworks/*OpenWrap*
Build/ReleaseArtifacts/XCFrameworks/*FBAudienceNetwork*

# Ignore release artifacts
Build/ReleaseArtifacts/Archives/*
Build/ReleaseArtifacts/Zips/*
Build/ReleaseArtifacts/Binary/*
Build/ReleaseArtifacts/ThirdParty/*

# Ignore adapter XCFrameworks (no longer used - adapters are source-only)
Build/ReleaseArtifacts/XCFrameworks/*Adapter*

# Ignore downloaded Kingfisher source files (downloaded via prepare_command during pod install)
ThirdParty/MSPKingfisher/Sources/

# Ignore all XCFrameworks by default, then whitelist required modules
**/*.xcframework

# Internal SDK XCFrameworks (must be committed)
!Build/ReleaseArtifacts/XCFrameworks/MSPCore.xcframework
!Build/ReleaseArtifacts/XCFrameworks/MSPiOSCore.xcframework
!Build/ReleaseArtifacts/XCFrameworks/NovaCore.xcframework
!Build/ReleaseArtifacts/XCFrameworks/MSPSharedLibraries.xcframework
!Build/ReleaseArtifacts/XCFrameworks/MSPOMSDK.xcframework
!Sources/Core/MSPOMSDK/OMSDK_Newsbreak1.xcframework

# PrebidMobile.xcframework - CANONICAL PATH (synchronized between CocoaPods and SPM)
# This file MUST be committed - both CocoaPods and SPM depend on it
!ThirdParty/PrebidMobile/
!ThirdParty/PrebidMobile/PrebidMobile.xcframework
!ThirdParty/PrebidMobile/PrebidMobile.xcframework/**

# Kingfisher.xcframework - Pre-built for NovaAdapter dependency
# Required because MSPKingfisher/Sources is not available during pre_install hook
# NovaAdapter's project.yml.template references this XCFramework
!ThirdParty/Kingfisher/
!ThirdParty/Kingfisher/Kingfisher.xcframework
!ThirdParty/Kingfisher/Kingfisher.xcframework/**
Scripts/xcframeworks/output-temp/
ExtractedFrameworks/

# Wrapper xcframeworks (generated, not source-controlled)
**/Wrapper/Frameworks/*.xcframework
ShimmerWrapper/Frameworks/*.xcframework
FBAudienceNetworkWrapper/Frameworks/*.xcframework
IronSourceSDKWrapper/Frameworks/*.xcframework
OpenWrapSDKWrapper/Frameworks/*.xcframework
MintegralAdSDKWrapper/Frameworks/*.xcframework
MobileFuseSDKWrapper/Frameworks/*.xcframework
InMobiSDKWrapper/Frameworks/*.xcframework
# Legacy path - now handled by exception above
# MSPSharedLibraries/PrebidMobile.xcframework

# Node / editor
node_modules/
.idea/
# Note: .husky directory should be committed to the repository (Husky best practice)

# Ruby / Bundler artifacts
bin/
cache/
/extensions/
gems/
specifications/
Gemfile.lock
.bundle/
vendor/
*.gem

# Release backup directories and temporary tests
release_backup_*/
/tmp/release_backup_*/
*_test*
*test_*
*_cocoapods.podspec

# Slack configuration (contains sensitive webhook URL)
Scripts/config/slack.conf

# Temporary build artifacts (still ignored)
BuildReports/
Tmp/
*.md.tmp
*.log
*.tmp

# Note: MigrationReports/ is NOT ignored - reports are visible but cleaned by pre-commit hook

# Auto-generated project.yml files (generated from *.template by generate_workspace.sh)
# Templates (*.template) are tracked, generated files are ignored
**/project.yml
!**/*.template

# Auto-generated Info.plist (generated from Info.plist.template)
Examples/MSPDemoApp/MSPDemoApp/Info.plist

# Root workspace symlink (points to .generated/msp-ios-sdk.xcworkspace)
msp-ios-sdk.xcworkspace

# Verification matrix outputs (auto-generated)
verification_matrix/

# ============================================================================
# Release System Test Artifacts (auto-generated, ignore)
# ============================================================================
# Test suite source code (run_all.sh, helpers.sh, mock/*, cases/*) is tracked.
# Only generated artifacts from test execution are ignored.

# Logs created by mock binaries
Scripts/tests/release_state/**/mock_invocations.log
Scripts/tests/release_state/**/mock_*.log

# Logs captured from test runs
Scripts/tests/release_state/**/test_output.log

# Synthetic state dumps created for rollback tests
Scripts/tests/release_state/**/test_state_*.json

# Temporary directories created by test runner or cases
Scripts/tests/release_state/**/tmp/
Scripts/tests/release_state/**/temp/
Scripts/tests/release_state/**/case_*/

# MSP Release System runtime state file
.msp-release-state.json

# Notification system test artifacts
Tests/notify_output/
Tests/notify_runner/*.log
Tests/notify_runner/*.tmp
Tests/notify_runner/__pycache__/
.envrc

# Generated project.yml files (from templates)
Sources/Adapters/*/project.yml
# Phase B temporary reports
docs/PHASE_B_COMPLETION_REPORT.md
Docs/PHASE_B_COMPLETION_REPORT.md
docs/PHASE_B_MIGRATION.md
Docs/PHASE_B_MIGRATION.md

# Temporary task file for branch synchronization (feature/spm_impl)
_task_feature_x.md
