pipeline {
    agent {
        label 'macos'
    }
    
    environment {
        LANG = 'en_US.UTF-8'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Setup') {
            steps {
                sh '''
                    bundle install
                    bundle exec pod install
                '''
            }
        }
        
        stage('Swift Format Check') {
            steps {
                sh '''
                    set -euo pipefail
                    
                    echo "🔍 Checking Swift code formatting..."
                    
                    # Function to find swift-format
                    find_swift_format() {
                        # Check system PATH first
                        if command -v swift-format &> /dev/null; then
                            echo "$(which swift-format)"
                            return 0
                        fi
                        
                        # Check Xcode toolchain (using DEVELOPER_DIR if set)
                        DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
                        if [ -f "$DEVELOPER_DIR/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format" ]; then
                            echo "$DEVELOPER_DIR/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format"
                            return 0
                        fi
                        
                        # Check default Xcode location
                        if [ -f "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format" ]; then
                            echo "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift-format"
                            return 0
                        fi
                        
                        return 1
                    }
                    
                    # Try to find existing swift-format
                    SWIFT_FORMAT=$(find_swift_format) || true
                    
                    if [ -z "$SWIFT_FORMAT" ] || [ ! -f "$SWIFT_FORMAT" ]; then
                        echo "📦 swift-format not found, installing from source..."
                        git clone --depth 1 https://github.com/apple/swift-format.git /tmp/swift-format
                        cd /tmp/swift-format
                        swift build -c release
                        sudo cp .build/release/swift-format /usr/local/bin/swift-format || cp .build/release/swift-format ~/.local/bin/swift-format
                        export PATH="$HOME/.local/bin:$PATH"
                        cd "${WORKSPACE}"
                        rm -rf /tmp/swift-format
                        SWIFT_FORMAT="swift-format"
                    else
                        echo "✅ Found swift-format at: $SWIFT_FORMAT"
                        if [ "$SWIFT_FORMAT" != "swift-format" ] && ! command -v swift-format &> /dev/null; then
                            mkdir -p ~/.local/bin
                            ln -sf "$SWIFT_FORMAT" ~/.local/bin/swift-format || true
                            export PATH="$HOME/.local/bin:$PATH"
                        fi
                    fi
                    
                    # Verify swift-format is available
                    if ! command -v swift-format &> /dev/null; then
                        echo "❌ swift-format not found after installation"
                        exit 1
                    fi
                    
                    swift-format --version
                    
                    # Read exclusion patterns from config file and build find command
                    EXCLUSIONS=""
                    if [ -f "swift-format-exclusions.txt" ]; then
                        while IFS= read -r line || [ -n "$line" ]; do
                            line=$(echo "$line" | sed 's/#.*$//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
                            if [ -z "$line" ]; then
                                continue
                            fi
                            if [[ "$line" =~ ^name:(.+)$ ]]; then
                                EXCLUSIONS="$EXCLUSIONS -not -name \"${BASH_REMATCH[1]}\""
                            elif [[ "$line" =~ ^path:(.+)$ ]]; then
                                pattern="${BASH_REMATCH[1]}"
                                if [[ "$pattern" == ./* ]]; then
                                    EXCLUSIONS="$EXCLUSIONS -not -path \"$pattern\""
                                else
                                    base_pattern="${pattern#*/}"
                                    EXCLUSIONS="$EXCLUSIONS -not -path \"./$base_pattern\" -not -path \"$pattern\""
                                fi
                            fi
                        done < swift-format-exclusions.txt
                    else
                        EXCLUSIONS="-not -name \"*.pb.swift\" -not -path \"./Pods/*\" -not -path \"*/Pods/*\" -not -path \"./build/*\" -not -path \"*/build/*\" -not -path \"./DerivedData/*\" -not -path \"*/DerivedData/*\" -not -path \"./.build/*\" -not -path \"*/.build/*\" -not -path \"./output*/*\" -not -path \"*/output*/*\" -not -path \"*/xcframework/*\" -not -path \"./.git/*\" -not -path \"*/.swiftpm/*\""
                    fi
                    
                    # Find all Swift files
                    swift_files=$(eval "find . -name \"*.swift\" $EXCLUSIONS")
                    
                    if [[ -z "$swift_files" ]]; then
                        echo "ℹ️ No Swift files found to format"
                        exit 0
                    fi
                    
                    # Check formatting using configuration file
                    CONFIG_FILE="swift-format.json"
                    unformatted_files=""
                    for file in $swift_files; do
                        if [ -f "$CONFIG_FILE" ]; then
                            if ! swift-format lint --configuration "$CONFIG_FILE" "$file" > /dev/null 2>&1; then
                                unformatted_files="$unformatted_files $file"
                            fi
                        else
                            if ! swift-format lint "$file" > /dev/null 2>&1; then
                                unformatted_files="$unformatted_files $file"
                            fi
                        fi
                    done
                    
                    if [[ -n "$unformatted_files" ]]; then
                        echo "❌ The following files are not properly formatted:"
                        for file in $unformatted_files; do
                            echo "  - $file"
                        done
                        echo ""
                        echo "💡 To fix formatting issues, run:"
                        echo "   swift-format -i <file>"
                        exit 1
                    else
                        echo "✅ All Swift files are properly formatted"
                    fi
                '''
            }
        }
        
        stage('Build Wrappers') {
            steps {
                sh '''
                    chmod +x Scripts/xcframeworks/build-all.sh
                    ./Scripts/xcframeworks/build-all.sh
                '''
            }
        }
        
        stage('Validate Parity') {
            steps {
                sh '''
                    chmod +x Scripts/validation/source-parity.sh
                    ./Scripts/validation/source-parity.sh
                '''
            }
        }
        
        stage('Regenerate Workspace') {
            steps {
                sh '''
                    chmod +x Scripts/workspace/update.sh
                    CI=1 ./Scripts/workspace/update.sh
                '''
            }
        }
        
        stage('Build CocoaPods') {
            steps {
                sh '''
                    xcodebuild -workspace msp-ios-sdk.xcworkspace \
                        -scheme MSPDemoApp \
                        -configuration Debug \
                        -sdk iphonesimulator \
                        -destination 'platform=iOS Simulator,name=iPhone 15' \
                        clean build \
                        CODE_SIGN_IDENTITY="" \
                        CODE_SIGNING_REQUIRED=NO \
                        CODE_SIGNING_ALLOWED=NO
                '''
            }
        }
        
        stage('Build SwiftPM') {
            steps {
                sh '''
                    xcodebuild -workspace msp-ios-sdk.xcworkspace \
                        -scheme MSPDemoApp-SPM \
                        -configuration Debug \
                        -sdk iphonesimulator \
                        -destination 'platform=iOS Simulator,name=iPhone 15' \
                        clean build \
                        CODE_SIGN_IDENTITY="" \
                        CODE_SIGNING_REQUIRED=NO \
                        CODE_SIGNING_ALLOWED=NO
                '''
            }
        }
        
        stage('Verify') {
            steps {
                sh '''
                    echo "✓ Both CocoaPods and SwiftPM builds completed successfully"
                    echo "✓ Source parity validated"
                    echo "✓ No orphan/ghost files detected"
                '''
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        failure {
            echo "Build failed - Pods/SPM consistency check failed"
        }
    }
}

