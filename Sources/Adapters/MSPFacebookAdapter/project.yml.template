# MSPFacebookAdapter XcodeGen Project Specification
# Uses shared template and adds MSPFacebookAdapter-specific overrides
# Template: Config/xcodegen/module.project_template.yml

include:
  - ../../../Configs/xcodegen/module.project_template.yml

name: MSPFacebookAdapter

settings:
  base:
    # Product Configuration
    PRODUCT_NAME: MSPFacebookAdapter
    PRODUCT_BUNDLE_IDENTIFIER: msp.MSPFacebookAdapter
    PRODUCT_MODULE_NAME: MSPFacebookAdapter

targets:
  MSPFacebookAdapter:
    type: framework
    platform: iOS
    sources:
      - path: MSPFacebookAdapter
        excludes:
          - "**/*.h"
          - "**/*.modulemap"
          - "**/*.md"
          - "**/Tests/**"
          - "**/*.test.swift"
          - "**/*.spec.swift"
          - "FacebookAdapter.docc/**"
    dependencies:
      - framework: ../../../Build/XCFrameworks/MSPiOSCore.xcframework
        embed: false
      - framework: ../../../Build/XCFrameworks/PrebidMobile.xcframework
        embed: false
      - framework: ../../../Pods/FBAudienceNetwork/Static/FBAudienceNetwork.xcframework
        embed: false
    settings:
      base:
        BUILD_LIBRARY_FOR_DISTRIBUTION: YES
        SKIP_INSTALL: NO
        
        # Framework Search Paths - XCFrameworks only
        FRAMEWORK_SEARCH_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../Build/XCFrameworks
          - $(SRCROOT)/../../Core/MSPSharedLibraries
          - $(SRCROOT)/../../../Sources/Core/ThirdParty/Kingfisher
          - $(SRCROOT)/../../../Sources/Core/ThirdParty/MSPSnapKit
          - $(SRCROOT)/../../../Sources/Core/ThirdParty/Lottie
          - $(SRCROOT)/../../../Sources/Core/ThirdParty/Shimmer
          - $(SRCROOT)/../../../Sources/Core/ThirdParty/SwiftProtobuf
          - $(SRCROOT)/../../../Sources/Core/MSPOMSDK/OMSDK_Newsbreak1.xcframework
          - $(SRCROOT)/../../../Sources/Wrappers/FBAudienceNetworkWrapper/Frameworks
        
        # Link zlib library (required by FBAudienceNetwork)
        OTHER_LDFLAGS: $(inherited) -lz

schemes:
  MSPFacebookAdapter:
    build:
      targets:
        MSPFacebookAdapter: all
    run:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
