# AmazonAdapter XcodeGen Project Specification
# Uses shared template and adds AmazonAdapter-specific overrides
# Template: Config/xcodegen/module.project_template.yml

include:
  - ../../../Configs/xcodegen/module.project_template.yml

name: AmazonAdapter

settings:
  base:
    # Product Configuration
    PRODUCT_NAME: MSPAmazonAdapter
    PRODUCT_BUNDLE_IDENTIFIER: msp.AmazonAdapter
    PRODUCT_MODULE_NAME: MSPAmazonAdapter

targets:
  AmazonAdapter:
    type: framework
    platform: iOS
    sources:
      - path: AmazonAdapter
        excludes:
          - "**/*.h"
          - "**/*.modulemap"
          - "**/*.md"
          - "**/Tests/**"
          - "**/*.test.swift"
          - "**/*.spec.swift"
          - "AmazonAdapter.docc/**"
    dependencies:
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/MSPiOSCore.xcframework
        embed: false
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/MSPGoogleAdsTypes.xcframework
        embed: false
      - framework: ../../../Pods/AmazonPublisherServicesSDK/APS_iOS_SDK-4.5.5/DTBiOSSDK.xcframework
        embed: false
      - framework: ../../../Pods/Google-Mobile-Ads-SDK/Frameworks/GoogleMobileAdsFramework/GoogleMobileAds.xcframework
        embed: false
    settings:
      base:
        BUILD_LIBRARY_FOR_DISTRIBUTION: YES
        SKIP_INSTALL: NO
        
        # Framework Search Paths - XCFrameworks only
        FRAMEWORK_SEARCH_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../Build/ReleaseArtifacts/XCFrameworks
          - $(SRCROOT)/../../Core/MSPSharedLibraries
          - $(SRCROOT)/../../../Sources/Core/MSPOMSDK/OMSDK_Newsbreak1.xcframework
          - $(SRCROOT)/../../../Pods/AmazonPublisherServicesSDK/APS_iOS_SDK-4.5.5
          - $(SRCROOT)/../../../Pods/Google-Mobile-Ads-SDK/Frameworks/GoogleMobileAdsFramework

schemes:
  AmazonAdapter:
    build:
      targets:
        AmazonAdapter: all
    run:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
