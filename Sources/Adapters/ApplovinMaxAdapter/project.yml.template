# ApplovinMaxAdapter XcodeGen Project Specification
# Uses shared template and adds ApplovinMaxAdapter-specific overrides
# Template: Config/xcodegen/module.project_template.yml

include:
  - ../../../Configs/xcodegen/module.project_template.yml

name: ApplovinMaxAdapter

settings:
  base:
    # Product Configuration
    PRODUCT_NAME: MSPApplovinMaxAdapter
    PRODUCT_BUNDLE_IDENTIFIER: msp.ApplovinMaxAdapter
    PRODUCT_MODULE_NAME: MSPApplovinMaxAdapter

targets:
  ApplovinMaxAdapter:
    type: framework
    platform: iOS
    sources:
      - path: ApplovinMaxAdapter
        excludes:
          - "**/*.h"
          - "**/*.modulemap"
          - "**/*.md"
          - "**/Tests/**"
          - "**/*.test.swift"
          - "**/*.spec.swift"
          - "ApplovinMaxAdapter.docc/**"
    dependencies:
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/MSPiOSCore.xcframework
        embed: false
      # PrebidMobile is an indirect dependency: MSPiOSCore imports it and its types appear
      # in MSPiOSCore.private.swiftinterface. The Swift compiler must be able to resolve
      # this transitive module when building ApplovinMaxAdapter.
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/PrebidMobile.xcframework
        embed: false
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/MSPSharedLibraries.xcframework
        embed: false
      - framework: ../../../Build/ReleaseArtifacts/XCFrameworks/MSPSnapKit.xcframework
        embed: false
      - framework: ../../../Pods/AppLovinSDK/applovin-ios-sdk-13.6.2/AppLovinSDK.xcframework
        embed: false
    settings:
      base:
        BUILD_LIBRARY_FOR_DISTRIBUTION: YES
        SKIP_INSTALL: NO

        # Framework Search Paths - XCFrameworks only
        FRAMEWORK_SEARCH_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../Build/ReleaseArtifacts/XCFrameworks
          - $(SRCROOT)/../../Core/MSPSharedLibraries
          - $(SRCROOT)/../../../Sources/Core/MSPOMSDK/OMSDK_Newsbreak1.xcframework
          - $(SRCROOT)/../../../Pods/AppLovinSDK

schemes:
  ApplovinMaxAdapter:
    build:
      targets:
        ApplovinMaxAdapter: all
    run:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
