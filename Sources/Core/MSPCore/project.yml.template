# MSPCore XcodeGen Project Specification
# Uses shared template and adds MSPCore-specific overrides
# Template: Config/xcodegen/module.project_template.yml

include:
  - ../../../Configs/xcodegen/module.project_template.yml

name: MSPCore

settings:
  base:
    # Product Configuration
    PRODUCT_NAME: MSPCore
    PRODUCT_BUNDLE_IDENTIFIER: msp.MSPCore
    PRODUCT_MODULE_NAME: MSPCore

targets:
  MSPCore:
    type: framework
    platform: iOS
    headers:
      public:
        - path: MSPCore/MSPCore.h
    sources:
      - path: MSPCore
        excludes:
          - "**/*.h"
          - "**/*.modulemap"
          - "**/*.md"
          - "**/Tests/**"
          - "**/*.test.swift"
          - "**/*.spec.swift"
    dependencies:
      - framework: ../../../Build/XCFrameworks/MSPiOSCore.xcframework
        embed: false
      - framework: ../../../Build/XCFrameworks/MSPSharedLibraries.xcframework
        embed: false
      - framework: ../../../Build/XCFrameworks/MSPPrebidAdapter.xcframework
        embed: false
      - framework: ../../../Build/XCFrameworks/PrebidMobile.xcframework
        embed: false
      - framework: ../../../Sources/Core/MSPOMSDK/OMSDK_Newsbreak1.xcframework
        embed: false
      # Third-party dependencies (Kingfisher, MSPSnapKit, Lottie, Shimmer, SwiftProtobuf)
      # are provided via Pods at application level. Core XCFrameworks use
      # @_implementationOnly imports and do NOT embed these frameworks.
    settings:
      base:
        BUILD_LIBRARY_FOR_DISTRIBUTION: YES
        SKIP_INSTALL: NO
        CLANG_ENABLE_MODULES: YES
        SWIFT_INSTALL_OBJC_HEADER: YES
        PUBLIC_HEADERS_FOLDER_PATH: Headers
        
        # Framework Search Paths - Core XCFrameworks only
        # Third-party dependencies are provided via Pods at application level
        FRAMEWORK_SEARCH_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../Build/XCFrameworks
          - $(SRCROOT)/../MSPSharedLibraries
          - $(SRCROOT)/../MSPOMSDK

        # Swift Include Paths for Pod modules - Platform-specific paths
        # Pod modules are pre-built into shared DerivedData and injected via build script
        # Note: MSPPrebidAdapter is now an XCFramework dependency (not from DerivedData)
        SWIFT_INCLUDE_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/MSPKingfisher
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/MSPSnapKit
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/lottie-ios
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/Shimmer
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/SwiftProtobuf

        HEADER_SEARCH_PATHS:
          - $(inherited)
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-$(PLATFORM_NAME)/SwiftProtobuf
        
        # Library search paths for static libraries (MSPSnapKit, SwiftProtobuf)
        # Note: MSPPrebidAdapter is now an XCFramework dependency
        LIBRARY_SEARCH_PATHS[sdk=iphoneos*]:
          - $(inherited)
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphoneos/MSPSnapKit
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphoneos/SwiftProtobuf
        LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*]:
          - $(inherited)
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphonesimulator/MSPSnapKit
          - $(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphonesimulator/SwiftProtobuf
        # Link static libraries (MSPSnapKit, SwiftProtobuf)
        # MSPPrebidAdapter is linked via XCFramework dependency
        OTHER_LDFLAGS[sdk=iphoneos*]:
          - $(inherited)
          - -L$(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphoneos/MSPSnapKit
          - -lMSPSnapKit
          - -L$(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphoneos/SwiftProtobuf
          - -lSwiftProtobuf
        OTHER_LDFLAGS[sdk=iphonesimulator*]:
          - $(inherited)
          - -L$(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphonesimulator/MSPSnapKit
          - -lMSPSnapKit
          - -L$(SRCROOT)/../../../.generated/DerivedData/build-shared/Build/Products/Release-iphonesimulator/SwiftProtobuf
          - -lSwiftProtobuf
        
        OTHER_SWIFT_FLAGS: "-no-verify-emitted-module-interface"
    postBuildScripts:
      - name: Copy Modulemap
        script: |
          set -e
          MODULEMAP_SOURCE="${SRCROOT}/MSPCore/MSPCore.modulemap"
          MODULEMAP_DEST="${TARGET_BUILD_DIR}/${PRODUCT_NAME}.framework/Modules/module.modulemap"
          if [ -f "$MODULEMAP_SOURCE" ]; then
            mkdir -p "$(dirname "$MODULEMAP_DEST")"
            cp "$MODULEMAP_SOURCE" "$MODULEMAP_DEST"
          fi
      - name: Ensure Umbrella Header
        script: |
          set -e
          HEADER_SOURCE="${SRCROOT}/MSPCore/MSPCore.h"
          HEADERS_DIR="${TARGET_BUILD_DIR}/${PRODUCT_NAME}.framework/Headers"
          if [ -f "$HEADER_SOURCE" ]; then
            mkdir -p "$HEADERS_DIR"
            if [ ! -f "$HEADERS_DIR/MSPCore.h" ]; then
              cp "$HEADER_SOURCE" "$HEADERS_DIR/MSPCore.h"
            fi
          fi

schemes:
  MSPCore-XCFramework:
    build:
      targets:
        MSPCore: all
    run:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
